{
  "name": "agent-knowledge",
  "version": "0.1.0",
  "description": "master-agent와 code-agent에 출처가 있는 근거를 제공하는 공용 지식 검색 프로젝트",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "bin": {
    "agent-knowledge": "dist/src/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=4 \"dist/tests/**/*.test.js\"",
    "eval": "npm run build && node dist/src/cli/main.js eval"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
